<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME">

    <Pane layoutX="35.0" layoutY="20.0" prefHeight="310.0" prefWidth="920.0"
          style="-fx-background-color: #F3F4F6;">
        <Label layoutX="38.0" layoutY="60.0" prefHeight="30.0" text="Product Code:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="123.0" prefHeight="30.0" text="Product Name:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="189.0" prefHeight="30.0" text="Amount">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="255.0" prefHeight="30.0" text="Supplier">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="420.0" layoutY="60.0" prefHeight="30.0" text="Purchase  Price:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="125.0" prefHeight="30.0" text="SubTotal:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="189.0" prefHeight="30.0" text="ID:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="257.0" prefHeight="30.0" text="Total Due:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="3.0" layoutY="1.0" prefHeight="30.0" prefWidth="103.0"
               text="New Purchase">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <TextField fx:id="purchaseProductCode" layoutX="130.0" layoutY="60.0"
                   prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="purchaseProductName" layoutX="130.0" layoutY="124.0"
                   prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="purchaseAmount" layoutX="130.0" layoutY="191.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <TextField fx:id="supplierPurchase" layoutX="130.0" layoutY="255.0"
                   prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="purchasePrice" layoutX="520.0" layoutY="60.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <TextField fx:id="purchaseSubtotal" editable="false" layoutX="521.0" layoutY="124.0"
                   prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="purchaseID" editable="false" layoutX="521.0" layoutY="191.0"
                   prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="PurchaseTotalDue" editable="false" layoutX="521.0" layoutY="253.0"
                   prefHeight="30.0" prefWidth="200.0"/>
        <Button fx:id="addPurchasebutton" layoutX="817.0" layoutY="40.0"
                mnemonicParsing="false" prefHeight="30.0" prefWidth="70.0" text="ADD">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="buyPurchasebutton" layoutX="817.0" layoutY="105.0"
                mnemonicParsing="false" prefHeight="30.0" prefWidth="70.0" text="BUY">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="deletPurchasebutton" layoutX="817.0" layoutY="175.0"
                mnemonicParsing="false" prefHeight="30.0" prefWidth="70.0" text="DELETE">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="newPurchaseButton" layoutX="817.0" layoutY="240.0"
                mnemonicParsing="false" prefHeight="30.0" prefWidth="70.0" text="NEW">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
    </Pane>
    <TableView fx:id="purchaseTable" layoutX="35.0" layoutY="375.0" prefHeight="150.0"
               prefWidth="920.0">
        <columns>
            <TableColumn prefWidth="97.0" text="ID"/>
            <TableColumn prefWidth="178.0" text="PRODUCT NAME"/>
            <TableColumn prefWidth="186.0" text="AMOUNT"/>
            <TableColumn prefWidth="153.0" text="PRICE"/>
            <TableColumn prefWidth="130.0" text="SUBTOTAL"/>
            <TableColumn prefWidth="175.0" text="SUPPLIER"/>

        </columns>
    </TableView>
</AnchorPane>
