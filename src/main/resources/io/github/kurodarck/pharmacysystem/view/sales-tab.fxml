<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME">

    <Pane layoutX="35.0" layoutY="20.0" prefHeight="310.0" prefWidth="920.0" style="-fx-background-color: #F3F4F6;">
        <Label layoutX="38.0" layoutY="60.0" prefHeight="30.0" text="Product Code:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="230.0" layoutY="67.0" text="ID">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="120.0" prefHeight="30.0" text="Amount:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="193.0" prefHeight="30.0" text="Client ID:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="264.0" prefHeight="30.0" prefWidth="66.0" text="Total Due:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="420.0" layoutY="60.0" prefHeight="30.0" text="Sale  Price:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="427.0" layoutY="122.0" prefHeight="30.0" text="SubTotal:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="193.0" prefHeight="30.0" text="Stock:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="264.0" prefHeight="30.0" text="Client Name:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="3.0" layoutY="1.0" prefHeight="30.0" prefWidth="103.0" text="New Sale">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <TextField fx:id="salesProductCode" layoutX="130.0" layoutY="60.0" prefHeight="30.0" prefWidth="90.0"/>
        <TextField fx:id="salesID" editable="false" layoutX="256.0" layoutY="60.0" prefHeight="30.0"
                   prefWidth="74.0"/>
        <TextField fx:id="salesProductName" layoutX="129.0" layoutY="121.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="salesAmount" layoutX="130.0" layoutY="195.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="salessupplier" layoutX="130.0" layoutY="264.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="salesPrice" layoutX="520.0" layoutY="60.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="salesSubtotal" editable="false" layoutX="520.0" layoutY="121.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <TextField fx:id="salesStock" editable="false" layoutX="521.0" layoutY="191.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <TextField fx:id="salesTotalDue" editable="false" layoutX="521.0" layoutY="262.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <Button fx:id="addSalesbutton" layoutX="817.0" layoutY="40.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="ADD">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="buySellbutton" layoutX="817.0" layoutY="105.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="SELL">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="deletSalesbutton" layoutX="817.0" layoutY="175.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="DELETE">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="newSalesButton" layoutX="817.0" layoutY="240.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="NEW">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
    </Pane>
    <TableView fx:id="saleTable" layoutX="35.0" layoutY="375.0" prefHeight="150.0" prefWidth="920.0">
        <columns>
            <TableColumn prefWidth="97.0" text="ID "/>
            <TableColumn prefWidth="178.0" text="PRODUCT NAME"/>
            <TableColumn prefWidth="186.0" text="AMOUNT"/>
            <TableColumn prefWidth="153.0" text="SALE PRICE"/>
            <TableColumn prefWidth="130.0" text="SUBTOTAL"/>
            <TableColumn prefWidth="175.0" text="CLIENT NAME"/>

        </columns>
    </TableView>
</AnchorPane>
