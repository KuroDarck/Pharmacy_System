<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <Pane layoutX="34.0" layoutY="52.0" prefHeight="270.0" prefWidth="520.0" style="-fx-background-color: #F3F4F6;">
            <Button fx:id="singUpCategory" layoutX="442.0" layoutY="23.0" mnemonicParsing="false" prefHeight="30.0"
                    prefWidth="60.0" text="Sign In">
                <font>
                    <Font name="Segoe Print Bold" size="12.0"/>
                </font>
            </Button>
            <Button fx:id="updateCategory" layoutX="442.0" layoutY="82.0" mnemonicParsing="false" prefHeight="30.0"
                    prefWidth="60.0" text="Update">
                <font>
                    <Font name="Segoe Print Bold" size="12.0"/>
                </font>
            </Button>
            <Button fx:id="deleteCategory" layoutX="442.0" layoutY="149.0" mnemonicParsing="false" prefHeight="30.0"
                    prefWidth="60.0" text="Delete">
                <font>
                    <Font name="Segoe Print Bold" size="12.0"/>
                </font>
            </Button>
            <Button fx:id="cancelCategory" layoutX="442.0" layoutY="209.0" mnemonicParsing="false" prefHeight="30.0"
                    prefWidth="60.0" text="Cancel">
                <font>
                    <Font name="Segoe Print Bold" size="12.0"/>
                </font>
            </Button>
            <Label layoutX="62.0" layoutY="40.0" prefHeight="30.0" text="ID:">
                <font>
                    <Font name="Segoe Print Bold" size="12.0"/>
                </font>
            </Label>
            <Label layoutX="62.0" layoutY="107.0" prefHeight="30.0" text="Name:">
                <font>
                    <Font name="Segoe Print Bold" size="12.0"/>
                </font>
            </Label>
            <TextField fx:id="idCategory" editable="false" layoutX="125.0" layoutY="40.0" prefHeight="30.0"
                       prefWidth="230.0"/>
            <TextField fx:id="nameCategory" layoutX="125.0" layoutY="107.0" prefHeight="30.0" prefWidth="230.0"/>
            <Label layoutX="3.0" layoutY="3.0" text="Category">
                <font>
                    <Font name="Segoe Print Bold" size="12.0"/>
                </font>
            </Label>
        </Pane>
        <TableView fx:id="categoryTable" layoutX="579.0" layoutY="96.0" prefHeight="226.0" prefWidth="415.0">
            <columns>
                <TableColumn prefWidth="98.0" text="ID" />
                <TableColumn prefWidth="353.0" text="NAME" />
            </columns>
        </TableView>
        <TextField fx:id="searchCategory" layoutX="654.0" layoutY="48.0" prefHeight="30.0" prefWidth="230.0" />
        <Label layoutX="579.0" layoutY="52.0" prefHeight="22.0" prefWidth="60.0" text="Search:">
            <font>
                <Font name="Segoe Print Bold" size="12.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
