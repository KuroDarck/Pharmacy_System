<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@/css/dashboard.css"
            fx:controller="io.github.kurodarck.pharmacysystem.controller.ProfileController"
            prefHeight="390.0" prefWidth="920.0">

    <Pane layoutX="40.0" layoutY="70.0" prefHeight="400.0" prefWidth="920.0" style="-fx-background-color: #F3F4F6;">
        <Label layoutX="2.0" layoutY="1.0" prefHeight="22.0" prefWidth="48.0" text="Profile">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="14.0" layoutY="60.0" prefHeight="30.0" text="User ID:">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="14.0" layoutY="125.0" prefHeight="30.0" text="Full Name:">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="12.0" layoutY="185.0" prefHeight="30.0" text="Address:">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="15.0" layoutY="245.0" prefHeight="30.0" text="Phone Number:">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="16.0" layoutY="305.0" prefHeight="30.0" prefWidth="60.0" text="Email:">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <TextField fx:id="userIdProfile" layoutX="118.0" layoutY="60.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="fullNameProfile" layoutX="118.0" layoutY="125.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="addessProfile" layoutX="118.0" layoutY="185.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="phoneNumberProfile" layoutX="118.0" layoutY="245.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="emailProfile" layoutX="118.0" layoutY="305.0" prefHeight="30.0" prefWidth="200.0"/>
        <PasswordField fx:id="newPasswordProfile" layoutX="539.0" layoutY="60.0" prefHeight="30.0" prefWidth="200.0"/>
        <PasswordField fx:id="confirmPasswordProfile" layoutX="539.0" layoutY="125.0" prefHeight="30.0"
                       prefWidth="200.0"/>
        <Label layoutX="397.0" layoutY="60.0" prefHeight="30.0" text="New password:">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="397.0" layoutY="125.0" prefHeight="30.0" text="Confirm password:">
            <font>
                <Font name="Segoe Print" size="12.0"/>
            </font>
        </Label>
        <Button fx:id="updateProfileBotton" layoutX="820.0" layoutY="60.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="60.0" text="Update"/>
    </Pane>
</AnchorPane>