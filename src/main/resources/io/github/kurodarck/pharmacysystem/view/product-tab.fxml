<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME">


    <Pane layoutX="55.0" layoutY="14.0" prefHeight="250.0" prefWidth="900.0"
          style="-fx-background-color: #F3F4F6;">
        <Button fx:id="saveProduct" layoutX="781.0" layoutY="20.0" mnemonicParsing="false"
                prefHeight="30.0" prefWidth="65.0" text="Save">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="updateProduct" layoutX="781.0" layoutY="80.0" mnemonicParsing="false"
                prefHeight="30.0" prefWidth="65.0" text="Update">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="removeProduct" layoutX="781.0" layoutY="140.0" mnemonicParsing="false"
                prefHeight="30.0" prefWidth="65.0" text="Remove">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="cancelProduct" layoutX="781.0" layoutY="200.0" mnemonicParsing="false"
                prefHeight="30.0" prefWidth="65.0" text="Cancel">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <ChoiceBox fx:id="CategoryProduct" layoutX="492.0" layoutY="120.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <Label layoutX="3.0" layoutY="1.0" text="Products">
            <font>
                <Font name="Segoe Print Bold" size="13.0"/>
            </font>
        </Label>
        <Label layoutX="28.0" layoutY="60.0" prefHeight="30.0" prefWidth="40.0" text="Code:">
            <font>
                <Font name="Segoe Print Bold" size="13.0"/>
            </font>
        </Label>
        <Label layoutX="28.0" layoutY="120.0" prefHeight="30.0" prefWidth="45.0" text="Name:">
            <font>
                <Font name="Segoe Print Bold" size="13.0"/>
            </font>
        </Label>
        <Label layoutX="28.0" layoutY="180.0" prefHeight="30.0" prefWidth="45.0" text="Price:">
            <font>
                <Font name="Segoe Print Bold" size="13.0"/>
            </font>
        </Label>
        <Label layoutX="385.0" layoutY="184.0" prefHeight="30.0" prefWidth="45.0" text="ID:">
            <font>
                <Font name="Segoe Print Bold" size="13.0"/>
            </font>
        </Label>
        <Label layoutX="385.0" layoutY="60.0" prefHeight="30.0" prefWidth="80.0"
               text="Description:">
            <font>
                <Font name="Segoe Print Bold" size="13.0"/>
            </font>
        </Label>
        <Label layoutX="385.0" layoutY="123.0" prefHeight="30.0" prefWidth="65.0"
               text="Category:">
            <font>
                <Font name="Segoe Print Bold" size="13.0"/>
            </font>
        </Label>
        <TextField fx:id="codeProduct" layoutX="90.0" layoutY="60.0" prefHeight="30.0"
                   prefWidth="200.0">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </TextField>
        <TextField fx:id="nameProduct" layoutX="90.0" layoutY="120.0" prefHeight="30.0"
                   prefWidth="200.0">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </TextField>
        <TextField fx:id="priceProduct" layoutX="90.0" layoutY="180.0" prefHeight="30.0"
                   prefWidth="200.0">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </TextField>
        <TextField fx:id="idProduct" editable="false" layoutX="493.0" layoutY="180.0"
                   prefHeight="30.0" prefWidth="200.0">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </TextField>
        <TextField fx:id="descriptionProduct" layoutX="490.0" layoutY="60.0" prefHeight="30.0"
                   prefWidth="200.0">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </TextField>
    </Pane>

    <TableView fx:id="tableProduct" layoutX="55.0" layoutY="362.0" prefHeight="175.0"
               prefWidth="900.0">
        <columns>
            <TableColumn prefWidth="113.0" text="ID"/>
            <TableColumn minWidth="0.0" prefWidth="126.0" text="CODE"/>
            <TableColumn prefWidth="169.0" text="PRICE"/>
            <TableColumn prefWidth="165.0" text="AMOUNT"/>
            <TableColumn prefWidth="162.0" text="CATEGORY"/>
            <TableColumn minWidth="0.0" prefWidth="164.0" text="NAME"/>
        </columns>
    </TableView>
    <TextField fx:id="searchProduct" layoutX="147.0" layoutY="310.0" prefHeight="30.0"
               prefWidth="200.0">
        <font>
            <Font name="Segoe Print Bold" size="12.0"/>
        </font>
    </TextField>
    <Label layoutX="85.0" layoutY="314.0" prefWidth="60.0" text="Search:">
        <font>
            <Font name="Segoe Print Bold" size="13.0"/>
        </font>
    </Label>
</AnchorPane>
