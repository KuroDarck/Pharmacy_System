<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME">

    <Pane layoutX="35.0" layoutY="20.0" prefHeight="310.0" prefWidth="920.0" style="-fx-background-color: #F3F4F6;">
        <Label layoutX="38.0" layoutY="60.0" prefHeight="30.0" text="Name:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="125.0" prefHeight="30.0" text="Address:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="190.0" prefHeight="30.0" prefWidth="73.0" text="Telephone:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="255.0" prefHeight="30.0" prefWidth="46.0" text="Email:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="420.0" layoutY="60.0" prefHeight="30.0" prefWidth="80.0" text="Description:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="130.0" prefHeight="30.0" prefWidth="42.0" text="City:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="190.0" prefHeight="30.0" text="Supliyer ID:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="6.0" layoutY="-1.0" prefHeight="30.0" prefWidth="103.0" text="Supplier">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <TextField fx:id="nameSupplier" layoutX="130.0" layoutY="60.0" prefHeight="30.0" prefWidth="250.0"/>
        <TextField fx:id="addressSupplier" layoutX="130.0" layoutY="125.0" prefHeight="30.0" prefWidth="250.0"/>
        <TextField fx:id="telephoneSupplier" layoutX="130.0" layoutY="190.0" prefHeight="30.0" prefWidth="250.0"/>
        <TextField fx:id="descriptionSupplier" layoutX="520.0" layoutY="60.0" prefHeight="30.0" prefWidth="250.0"/>
        <TextField fx:id="SupplierID" editable="false" layoutX="521.0" layoutY="190.0" prefHeight="30.0"
                   prefWidth="250.0"/>
        <Button fx:id="singUpSuppliyer" layoutX="817.0" layoutY="40.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Sing Up">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="upDateSuppliyer" layoutX="817.0" layoutY="105.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Update">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="deletSuppliyer" layoutX="817.0" layoutY="175.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Remove">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="cancelSuppliyer" layoutX="817.0" layoutY="240.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Cancel">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <TextField fx:id="emailSupplier" layoutX="130.0" layoutY="255.0" prefHeight="30.0" prefWidth="250.0"/>
        <ChoiceBox fx:id="citySupplier" layoutX="520.0" layoutY="130.0" prefHeight="30.0" prefWidth="250.0"/>
    </Pane>
    <TableView fx:id="tableSupplier" layoutX="35.0" layoutY="403.0" prefHeight="128.0" prefWidth="920.0">
        <columns>
            <TableColumn prefWidth="84.0" text="ID"/>
            <TableColumn prefWidth="130.0" text="NAME"/>
            <TableColumn prefWidth="130.0" text="DESCRIPTION"/>
            <TableColumn prefWidth="130.0" text="ADDRESS "/>
            <TableColumn prefWidth="130.0" text="TELEPHONE"/>
            <TableColumn minWidth="130.0" prefWidth="180.0" text="EMAIL"/>
            <TableColumn prefWidth="135.0" text="CITY"/>
        </columns>
    </TableView>
    <Label layoutX="58.0" layoutY="353.0" prefHeight="30.0" text="Search">
        <font>
            <Font name="Segoe Print Bold" size="12.0"/>
        </font>
    </Label>
    <TextField fx:id="searchSupplier" layoutX="114.0" layoutY="353.0" prefHeight="30.0" prefWidth="250.0"/>
</AnchorPane>
