<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME">
    <Pane layoutX="35.0" layoutY="20.0" prefHeight="310.0" prefWidth="920.0" style="-fx-background-color: #F3F4F6;">
        <Label layoutX="38.0" layoutY="60.0" prefHeight="30.0" text="Emproyee ID:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="125.0" prefHeight="30.0" text="Full Name:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="190.0" prefHeight="30.0" prefWidth="73.0" text="User Name:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="38.0" layoutY="250.0" prefHeight="30.0" text="Rol:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="420.0" layoutY="60.0" prefHeight="30.0" text="Address:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="125.0" prefHeight="30.0" text="Telephone:">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="190.0" prefHeight="30.0" text="Email">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="428.0" layoutY="250.0" prefHeight="30.0" text="Password">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <Label layoutX="3.0" layoutY="1.0" prefHeight="30.0" prefWidth="103.0" text="Employee">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Label>
        <TextField fx:id="idEmployee" layoutX="130.0" layoutY="60.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="fullNameEmloyee" layoutX="130.0" layoutY="125.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="userNameEmployee" layoutX="130.0" layoutY="190.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="addressEmployee" layoutX="520.0" layoutY="60.0" prefHeight="30.0" prefWidth="200.0"/>
        <TextField fx:id="telephoneEmployee" editable="false" layoutX="521.0" layoutY="125.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <TextField fx:id="emailEmployee" editable="false" layoutX="521.0" layoutY="190.0" prefHeight="30.0"
                   prefWidth="200.0"/>
        <Button fx:id="singUpEmpployee" layoutX="817.0" layoutY="40.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Sing Up">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="upDateEmployee" layoutX="817.0" layoutY="105.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Update">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="deletEmployee" layoutX="817.0" layoutY="175.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Remove">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <Button fx:id="cancelEmployee" layoutX="817.0" layoutY="240.0" mnemonicParsing="false" prefHeight="30.0"
                prefWidth="70.0" text="Cancel">
            <font>
                <Font name="Segoe Print Bold" size="12.0"/>
            </font>
        </Button>
        <ChoiceBox fx:id="rolEmployee" layoutX="130.0" layoutY="250.0" prefHeight="30.0" prefWidth="200.0"/>
        <PasswordField fx:id="passwordEmployee" layoutX="521.0" layoutY="250.0" prefHeight="30.0" prefWidth="200.0"/>
    </Pane>
    <TableView fx:id="employeeTable" layoutX="35.0" layoutY="403.0" prefHeight="128.0" prefWidth="920.0">
        <columns>
            <TableColumn prefWidth="84.0" text="ID"/>
            <TableColumn prefWidth="130.0" text="NAME"/>
            <TableColumn prefWidth="130.0" text="USER NAME"/>
            <TableColumn prefWidth="130.0" text="ADDRESS "/>
            <TableColumn prefWidth="130.0" text="TELEPHONE"/>
            <TableColumn minWidth="130.0" prefWidth="180.0" text="EMAIL"/>
            <TableColumn prefWidth="135.0" text="ROL"/>
        </columns>
    </TableView>
    <Label layoutX="59.0" layoutY="345.0" prefHeight="30.0" text="Search">
        <font>
            <Font name="Segoe Print Bold" size="12.0"/>
        </font>
    </Label>
    <TextField fx:id="searchEmployee" layoutX="120.0" layoutY="345.0" prefHeight="30.0" prefWidth="200.0"/>

</AnchorPane>
