<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="LoginView" accessibleText="480" prefHeight="415.0" prefWidth="930.0"
            stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.kurodarck.pharmacysystem.controller.LoginController">
    <Pane prefHeight="420.0" prefWidth="490.0" styleClass="custom-pane">
        <ImageView fitHeight="460.0" fitWidth="700.0" layoutX="-80.0" layoutY="-20.0" pickOnBounds="true"
                   preserveRatio="true" styleClass="side-image">
            <Image url="@../Image/wallpaper.jpg"/>
        </ImageView>
    </Pane>
    <Pane layoutX="440.0" prefHeight="420.0" prefWidth="490.0" styleClass="custom-pane">
        <TextField fx:id="text_UserName" layoutX="170.0" layoutY="153.0" prefHeight="30.0" prefWidth="277.0" styleClass="input-field"/>
        <PasswordField fx:id="txt_password" layoutX="170.0" layoutY="234.0" prefHeight="30.0" prefWidth="277.0" styleClass="input-field"/>
        <Label layoutX="181.0" layoutY="46.0" styleClass="title-label" text="Sign In"/>
        <Label layoutX="53.0" layoutY="160.0" styleClass="form-label" text="User Name:"/>
        <Label layoutX="64.0" layoutY="240.0" styleClass="form-label" text="Password:"/>
        <Button fx:id="Submit" layoutX="197.0" layoutY="310.0" mnemonicParsing="false" onAction="#OnSubmitButtonClick" styleClass="button-primary" text="Submit"/>

    </Pane>
</AnchorPane>
