<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<AnchorPane prefHeight="580.0" prefWidth="1008.0" styleClass="custom-pane" stylesheets="@../css/dashboard.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.kurodarck.pharmacysystem.controller.ProfileController">

    <!-- Section header with proper breathing room at the top -->
    <Label layoutX="40.0" layoutY="20.0" styleClass="section-title" text="Profile"/>

    <!-- Main card grouping personal info and password fields neatly -->
    <Pane layoutX="40.0" layoutY="62.0" prefHeight="468.0" prefWidth="928.0" styleClass="card">

        <!-- Left column: user details -->
        <Label layoutX="28.0" layoutY="28.0" prefHeight="36.0" prefWidth="125.0" styleClass="form-label"
               text="User ID:"/>
        <TextField fx:id="userIdProfile" layoutX="162.0" layoutY="28.0" prefHeight="36.0" prefWidth="220.0"
                   promptText="User ID..."/>

        <Label layoutX="28.0" layoutY="88.0" prefHeight="36.0" prefWidth="125.0" styleClass="form-label"
               text="Full Name:"/>
        <TextField fx:id="fullNameProfile" layoutX="162.0" layoutY="88.0" prefHeight="36.0" prefWidth="220.0"
                   promptText="Enter full name..."/>

        <Label layoutX="28.0" layoutY="148.0" prefHeight="36.0" prefWidth="125.0" styleClass="form-label"
               text="Address:"/>
        <TextField fx:id="addessProfile" layoutX="162.0" layoutY="148.0" prefHeight="36.0" prefWidth="220.0"
                   promptText="Enter address..."/>

        <Label layoutX="28.0" layoutY="208.0" prefHeight="36.0" prefWidth="125.0" styleClass="form-label"
               text="Phone Number:"/>
        <TextField fx:id="phoneNumberProfile" layoutX="162.0" layoutY="208.0" prefHeight="36.0" prefWidth="220.0"
                   promptText="Enter phone number..."/>

        <Label layoutX="28.0" layoutY="268.0" prefHeight="36.0" prefWidth="125.0" styleClass="form-label"
               text="Email:"/>
        <TextField fx:id="emailProfile" layoutX="162.0" layoutY="268.0" prefHeight="36.0" prefWidth="220.0"
                   promptText="Enter email..."/>

        <!-- Right column: password fields and save button -->
        <Label layoutX="430.0" layoutY="28.0" prefHeight="36.0" prefWidth="150.0" styleClass="form-label"
               text="New password:"/>
        <PasswordField fx:id="newPasswordProfile" layoutX="588.0" layoutY="28.0" prefHeight="36.0" prefWidth="296.0"
                       promptText="New password..."/>

        <Label layoutX="430.0" layoutY="88.0" prefHeight="36.0" prefWidth="150.0" styleClass="form-label"
               text="Confirm password:"/>
        <PasswordField fx:id="confirmPasswordProfile" layoutX="588.0" layoutY="88.0" prefHeight="36.0" prefWidth="296.0"
                       promptText="Confirm new password..."/>

        <!-- Primary action button aligned neatly below the password fields -->
        <Button fx:id="updateProfileBotton" layoutX="588.0" layoutY="152.0" mnemonicParsing="false" prefHeight="36.0"
                prefWidth="130.0" styleClass="button-primary" text="Update"/>
    </Pane>
</AnchorPane>