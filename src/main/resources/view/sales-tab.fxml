<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="580.0" prefWidth="1008.0" styleClass="custom-pane" stylesheets="@../css/dashboard.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.kurodarck.pharmacysystem.controller.SalesController">
    <!-- Main heading for the sales screen -->
    <Label layoutX="40.0" layoutY="14.0" styleClass="section-title" text="New Sale"/>

    <!-- Card container grouping sale fields and action buttons -->
    <Pane layoutX="40.0" layoutY="50.0" prefHeight="296.0" prefWidth="928.0" styleClass="card">
        <!-- Row 1: product code, sale ID and sale price -->
        <Label layoutX="24.0" layoutY="18.0" prefHeight="36.0" prefWidth="105.0" styleClass="form-label"
               text="Product Code:"/>
        <TextField fx:id="salesProductCode" layoutX="134.0" layoutY="18.0" prefHeight="36.0" prefWidth="92.0"
                   promptText="Code..."/>

        <Label layoutX="236.0" layoutY="18.0" prefHeight="36.0" prefWidth="28.0" styleClass="form-label"
               text="ID:"/>
        <TextField fx:id="salesID" editable="false" layoutX="268.0" layoutY="18.0" prefHeight="36.0"
                   prefWidth="82.0" promptText="ID"/>

        <Label layoutX="382.0" layoutY="18.0" prefHeight="36.0" prefWidth="115.0" styleClass="form-label"
               text="Sale Price:"/>
        <TextField fx:id="salesPrice" layoutX="502.0" layoutY="18.0" prefHeight="36.0" prefWidth="240.0"
                   promptText="0.00"/>

        <!-- Row 2: product name and subtotal -->
        <Label layoutX="24.0" layoutY="68.0" prefHeight="36.0" prefWidth="105.0" styleClass="form-label"
               text="Product:"/>
        <TextField fx:id="salesProductName" layoutX="134.0" layoutY="68.0" prefHeight="36.0" prefWidth="216.0"
                   promptText="Product name..."/>

        <Label layoutX="382.0" layoutY="68.0" prefHeight="36.0" prefWidth="115.0" styleClass="form-label"
               text="SubTotal:"/>
        <TextField fx:id="salesSubtotal" editable="false" layoutX="502.0" layoutY="68.0" prefHeight="36.0"
                   prefWidth="240.0" promptText="0.00"/>

        <!-- Row 3: quantity/amount and available stock -->
        <Label layoutX="24.0" layoutY="118.0" prefHeight="36.0" prefWidth="105.0" styleClass="form-label"
               text="Amount:"/>
        <TextField fx:id="salesAmount" layoutX="134.0" layoutY="118.0" prefHeight="36.0" prefWidth="216.0"
                   promptText="Quantity..."/>

        <Label layoutX="382.0" layoutY="118.0" prefHeight="36.0" prefWidth="115.0" styleClass="form-label"
               text="Stock:"/>
        <TextField fx:id="salesStock" editable="false" layoutX="502.0" layoutY="118.0" prefHeight="36.0"
                   prefWidth="240.0" promptText="Available stock..."/>

        <!-- Row 4: supplier/client reference and total due -->
        <Label layoutX="24.0" layoutY="168.0" prefHeight="36.0" prefWidth="105.0" styleClass="form-label"
               text="Supplier / Ref:"/>
        <TextField fx:id="salessupplier" layoutX="134.0" layoutY="168.0" prefHeight="36.0" prefWidth="216.0"
                   promptText="Supplier or client..."/>

        <Label layoutX="382.0" layoutY="168.0" prefHeight="36.0" prefWidth="115.0" styleClass="form-label"
               text="Total Due:"/>
        <TextField fx:id="salesTotalDue" editable="false" layoutX="502.0" layoutY="168.0" prefHeight="36.0"
                   prefWidth="240.0" promptText="0.00"/>

        <!-- Action buttons stacked neatly on the right side of the card -->
        <Button fx:id="addSalesbutton" layoutX="776.0" layoutY="18.0" mnemonicParsing="false" prefHeight="36.0"
                prefWidth="124.0" styleClass="button-primary" text="ADD"/>
        <Button fx:id="buySellbutton" layoutX="776.0" layoutY="68.0" mnemonicParsing="false" prefHeight="36.0"
                prefWidth="124.0" styleClass="button-primary" text="SELL"/>
        <Button fx:id="deletSalesbutton" layoutX="776.0" layoutY="118.0" mnemonicParsing="false" prefHeight="36.0"
                prefWidth="124.0" styleClass="button-primary" text="DELETE"/>
        <Button fx:id="newSalesButton" layoutX="776.0" layoutY="168.0" mnemonicParsing="false" prefHeight="36.0"
                prefWidth="124.0" styleClass="button-primary" text="NEW"/>
    </Pane>

    <!-- Table showing items added to the current sale -->
    <TableView fx:id="saleTable" layoutX="40.0" layoutY="362.0" prefHeight="196.0" prefWidth="928.0">
        <columns>
            <TableColumn prefWidth="95.0" text="ID "/>
            <TableColumn prefWidth="195.0" text="PRODUCT NAME"/>
            <TableColumn prefWidth="150.0" text="AMOUNT"/>
            <TableColumn prefWidth="155.0" text="SALE PRICE"/>
            <TableColumn prefWidth="145.0" text="SUBTOTAL"/>
            <TableColumn prefWidth="186.0" text="CLIENT NAME"/>
        </columns>
    </TableView>
</AnchorPane>